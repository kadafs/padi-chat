# Production Dockerfile for Padi Chat
# This is a simplified production-ready Dockerfile

FROM ruby:3.3.5-slim-bullseye

# Set environment variables
ENV LANG=C.UTF-8 \
    BUNDLE_JOBS=4 \
    BUNDLE_RETRY=3 \
    RAILS_ENV=production \
    NODE_ENV=production

# Install system dependencies
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    git \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Install Yarn
RUN npm install -g yarn@1.13.0

# Configure bundler
RUN gem update --system && \
    gem install bundler:2.3.26

# Create app directory
RUN mkdir -p /app
WORKDIR /app

# Copy dependency files
COPY Gemfile Gemfile.lock package.json yarn.lock ./

# Install dependencies
# Clear bundler cache to ensure fresh git fetches
RUN rm -rf /usr/local/bundle/cache && \
    rm -rf /root/.bundle/cache && \
    bundle install --jobs ${BUNDLE_JOBS} --retry ${BUNDLE_RETRY} && \
    yarn install --frozen-lockfile

# Copy application code
COPY . .

# Precompile assets
RUN SECRET_KEY_BASE=dummy \
    RAILS_ENV=production \
    bundle exec rails assets:precompile && \
    rm -rf node_modules tmp/cache/* /tmp/*

# Create non-root user
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 3000

# Start the application
CMD ["bundle", "exec", "puma", "-C", "config/puma.rb"]

